{
  "name": "@ecohub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EcoHub Backend API — Express + Prisma + Pinata",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "lint": "eslint src --ext .ts",
    "seed": "prisma migrate deploy && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "pinata": "^2.5.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^7.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5"
  }
}
